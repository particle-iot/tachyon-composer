#!/bin/sh
case "${1:-}" in prereqs) exit 0;; esac
# Have firmware available before real-root udev probes ath11k.
mkdir -p "${rootmnt}/vendor"
if ! mount -t vfat -o ro,nosuid,nodev,noexec /dev/disk/by-partlabel/core_nhlos_a "${rootmnt}/vendor"; then
    echo 'TACHYON: early vendor mount failed; Wi-Fi firmware may be unavailable' >&2
fi
