{
  "sources": {
    // New BP firmware (Quectel r108) — referenced as a published ARTIFACT ONLY, never as a
    // repo dependency. Provides the boot chain (xbl/uefi/tz/aop/hyp/...), the QCM6490 fw, and
    // the pre-built region NON-HLOS images (nonhlos-em.img / nonhlos-na.img). Boot blobs are
    // TEST-signed; the composer RE-SIGNS them with the selectable key (see signing block).
    // Replaces the old 20.04 base (tachyon-release-builder) + U-Boot.
    // 2.0.3 was the NON-HLOS-packaging release (#7) — first to ship nonhlos-em.img /
    // nonhlos-na.img alongside QCM6490_bootbinaries + QCM6490_fw. Since then:
    //   2.0.4 (#8) XBL: fix low-battery boot stuck in the UEFI charging loop.
    //   2.0.5 (#9) qup: hand QUPV3_1_SE0 to HLOS as the 40pin header UART.
    //   2.0.6 (#10) grub: resolve the rootfs by PARTLABEL, not /dev/sda3.
    //   2.0.7 (#11) battman: request DR_Swap when DP alt mode needs this port to be the DFP.
    //   2.0.8 (#13) usbpd: forbid sink-initiated Hard Reset. A batteryless board on a 5V source
    //     that never completes a PD contract (MacBook port, Xiaomi 65W) ended its protocol-error
    //     path in a Hard Reset; the source then drops VBUS to vSafe0V for up to ~1.7s and the
    //     board dies on the spot, ~21s into boot, and does not come back. Now intercepted at
    //     pe_snk_state_hard_reset_init(), the single entry for every sink-initiated Hard Reset.
    //     Source-initiated resets and real-battery behaviour are unchanged. 2.0.8 keeps the same
    //     519-entry layout with both nonhlos images (verified), so fetch/split is unaffected.
    //   2.0.9 (#14) cdsp: raise PWR_CLK_RDY only after qdsp_pm has placed the Q6's own votes.
    //     The CDSP failed to start on most COLD boots -- `qcom_q6v5_pas a300000.remoteproc:
    //     start timed out` then `can't start rproc ...: -110` -- and stayed offline; warm
    //     reboots passed, which is why it read as intermittent. Clock_ImagePostInit() raised the
    //     handover bit from RCINIT_GROUP_0, and HLOS drops all its proxy votes on that bit --
    //     including the MASTER_CDSP_PROC -> EBI1 bandwidth vote -- while qdsp_pm (RCINIT_GROUP_2)
    //     had not yet placed the Q6's own, so the image was starved before it held its own votes.
    //     clk_regime_imagepostinit now registers in RCINIT_GROUP_2 with a dependency on qdsp_pm,
    //     the ordering Qualcomm already ships in this SDK's DSP.AT.1.0 trees. Cold boots with
    //     CDSP up: 6/18 shipped -> 10/10 with the change. One commit, one scons file.
    // 2.0.5 had to move together with kernel particle5: BP #9 releases the SE to HLOS and kernel
    // #38 enables it in DT, and bumping only one side leaves the 40pin header UART dead. That
    // pairing is satisfied and stays satisfied here.
    // 2.0.6 is inert on this path: its grub fix is for the SDK's own tools/make-efi-img, whereas
    // the composer builds efi.img from its OWN vendored copy (scripts/efi/grub-efi-src-dir), which
    // already resolves root=PARTLABEL=system. It is picked up only because we were two behind.
    // 2.0.7 is the live change: attached as a PD Sink the port starts as UFP, DP alt mode entry
    // needs it to be the DFP, and nothing asked for the swap -- so whether an external display lit
    // up depended on the monitor requesting it, and with no battery attached the screen stayed
    // dark. It pairs with kernel particle8, which fixes what happened once DP *did* come up.
    // The artifact layout is unchanged from 2.0.3 (same 519 entries, both nonhlos images), so the
    // fetch/split in `make fetch_bp_fw` needs no changes. Re-verified for 2.0.9 by reading both
    // zips' central directories: 519 entries either side, same four top-level members, nothing
    // added or removed; 62 entries differ (the rebuilt boot binaries plus the adsp/cdsp firmware
    // and the two nonhlos images that embed them).
    "bp-fw": {
      "version": "2.0.9",
      "url": "https://tachyon-ci.particle.io/release/tachyon-bp-fw-2.0.9.zip"
    },

    // The 24.04 base rootfs image (built by particle-iot/tachyon-ubuntu-24.04 via livecd-rootfs).
    // Consumed as tachyon-ubuntu-24.04-<VARIANT>-image-<param>.img.xz from the release channel.
    // Variants: headless (== server) and desktop, both published.
    // 30-5321e13 was rebuilt against the latest particle kernel, so it already carries
    // linux-particle 6.8.0-1058.59+particle10 — matching the kernel pinned below.
    "particle-iot/tachyon-ubuntu-24.04": {
      "type": "git_release",
      "param": "30-5321e13"
    },

    // Kernel input (single source of truth for the kernel line). Unlike main — where this was the
    // "See PKG_linux_particle below" placeholder and the kernel was never fetched — the new-BP flow
    // FETCHES this kernel modules deb to extract qcm6490-tachyon.dtb for dtb_a, so these are real
    // download coordinates. The version here MUST stay in lock-step with PKG_linux_particle in the
    // env block below and the kernel baked into the 24.04 base (ABI 1058), or check-pinned-packages
    // will fail.  <-- deb_version == env.PKG_linux_particle (see below)
    "particle-iot/tachyon-ubuntu-24.04-kernel": {
      "type": "s3_release",
      "param": "stable-6.8.0-1058.59particle10",
      "abi": "1058",
      // keep this equal to env.PKG_linux_particle below
      "deb_version": "6.8.0-1058.59+particle10",
      "base_url": "https://linux-dist.particle.io/kernel/release"
    },

    // Overlay stack applied to the rootfs (packages, configs, Particle services). The former
    // 1.1 layout and its `when: { env: ENV_UBUNTU_24_04_VERSION, min: "1.2" }` gates were
    // retired; the firmware/audio/modem overlays now apply unconditionally.
    // Pinned to a full 40-char commit sha, not `main`: the composer fetches this with
    // `git fetch --depth 1 origin <ref>`, so a moving ref makes a build non-reproducible
    // and lets overlay behaviour change under a composer release. Abbreviated shas do
    // NOT work here -- the server rejects them ("couldn't find remote ref"). Bump this
    // deliberately when you want new overlays.
    // 43aeed16 (#43) = "Backport the two fixes left behind on feature/new-bp (/vendor from
    // initramfs, HDMI UCM verb)". Wi-Fi is the reason to take this. link-ath11k-firmware (already
    // shipped, via overlays #26) symlinks /lib/firmware/updates/ath11k/.../board.bin ->
    // /vendor/wlan/bdwlang.elf, but /vendor was mounted only by fstab at local-fs.target, ~300ms
    // AFTER udev autoloads ath11k_pci -- so the board file is missing and the card never appears.
    // amss.bin/m3.bin are the quieter half: linux-firmware ships same-named blobs, so those
    // resolved to the upstream file instead of the vendor one with nothing logged. #43 adds an
    // initramfs init-bottom hook that mounts core_nhlos_a before switch_root, replacing the race
    // with a fixed ordering. Latent since 1.2.6 -- NOT a 1.2.20 regression; being a race is why it
    // took two months to get reported. Also restores the HDMI UCM verb split, unrelated but
    // stranded on the same branch: an unplugged DisplayPort used to fail the whole HiFi verb.
    // 276e9868 = "24.04: ship NetworkManager's connectivity conf so first boot doesn't restart NM"
    // (#40). Adds add-nm-connectivity-check to the 24.04 stack only. It writes the exact bytes
    // particled would otherwise write to /etc/NetworkManager/conf.d/20-connectivity.conf, so on a
    // fresh image particled finds the file already correct and never restarts NetworkManager --
    // the restart that landed mid-Wi-Fi-association and cost ~7m30s before the first boot reached
    // connected. The file header is load-bearing and the overlay test compares byte-for-byte: if
    // particle-linux ever changes DESIRED_CONNECTIVITY_CONF, this overlay has to change with it.
    // Pairs with PKG_particle_linux 0.26.1-1 below; either alone helps, both together is the fix.
    // Re-checked for 0.26.1: src/daemon/InternetState.ts is not in the 0.25.2...0.26.1 diff, so
    // DESIRED_CONNECTIVITY_CONF is byte-identical and this overlay's comparison still holds.
    // dc2f331b (#39) = "set-initial-time: compare against the setup time, not a hardcoded 2024".
    "particle-iot/tachyon-overlay": {
      "type": "git_release",
      "param": "acca7e9fc9659d2b46528614ef5e3ba7bdd56fbb"
    },

    // The overlay TOOL (engine that applies the stack). Provides the `when` env-gate and ENV_*
    // chroot forwarding the new-BP stack relies on (PR #3 merged to main).
    // Pinned for the same reason as tachyon-overlay above: full 40-char sha, bumped
    // deliberately. This tool applies the overlay stack, so a silent change here rewrites
    // how every overlay is applied.
    "particle-iot/tachyon-overlay-tool": {
      "type": "git_release",
      "param": "0b5f8fb597a8ba17e6e7035a0ca13d16ef29599c"
    },

    // The Kigen LPA (eSIM local profile assistant) shipped as a prebuilt binary.
    // Private repo: fetched on the HOST by fetch_kigen_sdk and handed to the
    // overlay container as a resource, because the container has no credentials.
    "particle-iot-inc/kigen-sdk": {
      "type": "git_release",
      "param": "0.1.8",
      "asset": "lpa-linux-arm64"
    }
  },

  // Signing configuration. The composer signs every boot/firmware blob itself (selectable key).
  // profile=test  -> local test signer; key resolves to ./keys/<key>/ (committed test keys only).
  // profile=prod  -> production/proprietary key supplied at build time via secret/mount, NEVER
  //                  committed. See scripts/signing/README.md and keys/README.md.
  "signing": {
    "profile": "test",
    "key": "qti_presigned_certs-key2048_exp257_hashSHA384"
  },

  "env": {
    // Kernel version pinned INSIDE the rootfs by the overlay. MUST equal the kernel source
    // deb_version above (6.8.0-1058.59+particle7) and be installable on the base image's ABI.
    "PKG_linux_particle": "6.8.0-1058.59+particle10",

    // Optional: URL to manually install kernel .deb (for unpublished PR builds).
    // Multiple URLs separated by @@@ for related packages (image + modules).

    //This is the particle debian package. 0.25.2 fixes the other half of the first-boot stall
    //that the 1.2.18 run on head1 surfaced. particled compared 20-connectivity.conf against its
    //desired contents, found it absent, wrote it and RESTARTED NetworkManager -- which tore down
    //the Wi-Fi association in progress and left the device offline for ~7m30s. 0.25.2 reloads
    //NetworkManager instead (systemctl reload, falling back to a restart only if reload fails);
    //a reload re-reads conf.d without touching live connections. It also bounds the
    //CheckConnectivity D-Bus call at 30s: the call has no timeout of its own, and one that never
    //returned would stop the forced-connectivity timer rescheduling and silently defeat the
    //workaround it exists to drive. The overlay above stops the rewrite happening at all on a
    //fresh image; this covers upgrades and any image built without that overlay.
    //Published to `latest`, as every particle-linux release since 0.22.1-1 is.
    //
    //0.26.0 makes first-boot bootstrap durable, which matters here because the setup blob on
    //`misc` is the only copy. applyBootstrap() previously wrote the config with a plain
    //writeFileSync and then immediately ran `dd if=/dev/zero of=<misc>`, so a power loss between
    //the two lost the settings with their only source already gone -- and the release-channel
    //write was fire-and-forget (`void bootstrapReleaseChannel(...)`), so it could still be in
    //flight when misc was cleared. Now Config.saveDurably() writes a 0600 temp file, fsyncs it,
    //renames it over the target and fsyncs the directory; the channel write is awaited; `sync`
    //runs; only then is the record erased. eraseBootstrap() also stops zeroing the whole
    //partition -- it clears exactly the 4-byte header plus the record it just read, bounded at
    //1 MiB, with an explicit fsync, instead of relying on dd's ENOSPC being harmless.
    //0.26.0 also reports the applied env hash back as EnvDoc.device_hash once the files are on
    //disk (#153), so the server learns which values a device is actually running rather than
    //which ones were published to it.
    //
    //0.26.1 is packaging hygiene, and the reason to read the two bumps below as one change:
    //dh_auto_install runs a Makefile `install` target whenever one exists, so adding one for the
    //QLI RPM build silently staged the RPM layout into the Debian package too, putting the
    //systemd unit at BOTH /lib/systemd/system and /usr/lib/systemd/system. On a usrmerged rootfs
    //-- every Tachyon image -- those are one path with two archive members and dpkg refuses to
    //unpack. That is exactly what made particle-tachyon-ril 0.8.0/0.8.1 and
    //particle-tachyon-syscon 1.1.0-1 uninstallable. particle-linux escaped only because it has
    //no top-level Makefile; 0.26.1 says so explicitly in debian/rules, asserts the staging tree
    //stays clean, and adds CI tests that fail if an `install` target ever appears.
    "PKG_particle_linux": "0.26.1-1",

    //Radio code (RIL). 0.7.0 configures the modem's RF for the antenna that is
    //attached, and makes it a switchable profile rather than a one-shot fix. The
    //SG560D enables 4x4 MIMO on NR5G and LTE by default, which raises the packet
    //loss rate on the two-element moulded antenna, and NA boards additionally have
    //to run at reduced TX power for FCC certification -- but an external antenna
    //adapter is a different aerial, so those settings belong to the antenna and not
    //to the board. 0.7.0 adds `antenna --set internal|external`, `--get` and
    //`--list` to ctl plus SetAntenna/GetAntenna on D-Bus, persists the profile in
    ///etc/particle/antenna.yaml, and defaults to internal -- so a device that
    //upgrades into this version and has never been configured lands on the
    //FCC-correct profile. It reads all three settings before writing any of them,
    //so a modem that cannot answer is left alone rather than half configured: MIMO
    //written with TX power still at full is exactly the state an NA board is not
    //certified for. It also refuses to touch a board whose AT+GMR variant is
    //neither NA nor EM, and resets the modem rather than rebooting the device,
    //tracking the reset separately from the write because AT+QTXPWR resets the
    //modem by itself.
    //This supersedes the modem-rf-config overlay. tachyon-overlays#41 is closed and
    //never landed on main, so there is nothing to remove alongside this bump; the
    //package form also reaches devices already in the field through `apt upgrade`
    //rather than needing an OS image update, and avoids that overlay's first-boot
    //reboot landing in the middle of setup, cloud claim and eSIM download.
    //Published to the `latest` feed, not `stable`, exactly as 0.6.x is.
    //
    //0.8.0 (#63) is the QLI release -- native RPM packaging, shared modem AT leases,
    //NetworkManager cellular activation. The Debian package keeps the same D-Bus and CLI
    //surface, so it carries no behaviour change on 24.04.
    //
    //0.8.1 (#64) adds `gnss --active-antenna [on|off]` plus SetActiveAntenna and the
    //ActiveAntenna property on D-Bus. It drives the LDO that biases a powered (active) GNSS
    //antenna on GPIO43, defaults to OFF, and persists in /etc/particle/gps.yaml next to
    //`enabled` and `interval`. Deliberately independent of `gnss --power`: it describes the
    //aerial wired to the board, not whether the receiver is running, so powering the receiver
    //down leaves the LDO alone. A failed GPIO write exits non-zero and leaves ActiveAntenna
    //unchanged, so it never reports a rail it did not actually set.
    //
    //0.8.2 (#66) and 0.8.3 (#67) are the fix for the packaging defect 0.8.0 introduced: the
    //Makefile gained an `install` target for the RPM build, dh_auto_install ran it on its own,
    //and the Debian package ended up shipping the three unit files at both /lib/systemd/system
    //and /usr/lib/systemd/system -- one path on a usrmerged rootfs, so dpkg refused to unpack
    //and 0.8.0-1/0.8.1-1 could not be installed at all. 0.8.2 suppressed it with an override;
    //0.8.3 removed the target outright (nothing called it -- the RPM spec's %install runs
    //packaging/install.sh directly) and added CI packaging tests. Verified here before pinning:
    //the 0.8.4-1 deb has zero colliding paths once /lib, /bin and /sbin are resolved through
    //their usrmerge symlinks, and carries only the three units under lib/systemd/system.
    //
    //0.8.4 (#68) is the live fix: `antenna --set` could apply the WRONG profile.
    //method_set_antenna() writes the config from the bus thread with no lock while the worker
    //thread reads the same statics in applyAntennaConfig(); readAntennaConfig() clears the
    //struct and seeds it with the default (internal) before parsing, so a reader arriving in
    //that window sees `internal` whatever the file says. The board is then configured for the
    //internal aerial while asking for the external one: 2x2 MIMO, and on an NA board reduced TX
    //power. The window stays open for as long as an apply takes -- tens of seconds, because it
    //resets the modem -- so a second `antenna --set` during the first is enough to hit it.
    //Present since 0.7.0, i.e. every 0.7.x and 0.8.x before this, and silent: `antenna --get`
    //reports the configured profile, not the one the modem was given. Nothing on disk is wrong,
    //so a device recovers at the next boot or the next `antenna --set`. The config module now
    //takes a mutex around the four functions touching those statics, and the host suite
    //reproduces the race rather than asserting the fix is present.
    "PKG_particle_tachyon_ril": "0.8.4-1",

    //The syscon package. 1.1.0 added native QLI RPM packaging and nothing else -- it explicitly
    //retains syscon firmware v1.0.52 and mspm0flash 0.4.3 -- so on 24.04 this bump ships the
    //SAME MCU firmware as 1.0.52-1 did, just rebuilt. 1.1.0-1 itself is uninstallable: it hit
    //the dh_auto_install trap described under PKG_particle_linux above and shipped
    //particle-tachyon-syscon.service at both /lib/systemd/system and /usr/lib/systemd/system.
    //1.1.1 removes the Makefile `install` target rather than only suppressing it, and adds the
    //same CI packaging tests as the RIL. Verified before pinning: the 1.1.1-1 deb has zero
    //colliding paths after usrmerge resolution.
    "PKG_particle_tachyon_syscon": "1.1.1-1",

    //Umbrella metapackage (Section: metapackages, Installed-Size 7) whose entire content is
    //`Depends: particle-linux, particle-tachyon-ril, particle-tachyon-syscon`. New pin: it gives
    //the image a single package that names the Particle stack, so `apt install particle-tachyon`
    //is a meaningful thing to ask for on a device. The dependencies are unversioned, so it does
    //not fight the three exact pins above -- apt satisfies them with the pinned versions, which
    //the pin file holds at PIN_PRIORITY.
    "PKG_particle_tachyon": "1.0.0-1",

    //version used in the debian file to pin the version down
    "PIN_PRIORITY": "900"
  },

  // Variant-only pins. Folded into the overlay env by the Makefile as
  // env_<INPUT_VARIANT>, so these apply to that variant alone.
  // particle-tachyon-desktop-setup lived in the shared env, which meant the pin
  // machinery installed it on headless too.
  "env_desktop": {
    //Version of the setup app being used
    "PKG_particle_tachyon_desktop_setup": "2.7.0"
  }
}
